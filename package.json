{
  "name": "universal-ai-game-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-assisted modular game creation studio (Project 4)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "npm run -w @gamestudio/desktop tauri -- dev",
    "dev:web": "npm run -w @gamestudio/desktop dev",
    "build:web": "npm run -w @gamestudio/desktop build",
    "build:app": "npm run -w @gamestudio/desktop tauri -- build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm test && npm run test:rust"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
